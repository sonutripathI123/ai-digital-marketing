# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables, credentials, and service accounts
.env
.env*
*.env
*.backup
*.pem
*.key
gsc-service-account.json
gsc-service-account*.json
credentials*.json
client_secret*.json

# Virtual environments
venv/
.venv/
env/

# IDE files
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store

# Local database & logs
logs/
logs/*
*.log

# Per-site social credentials projected from the website registry (contains tokens)
data/site_social_credentials.json

# Per-site WordPress credentials projected from the website registry
# (contains application passwords)
data/site_blog_credentials.json

# Visitor access telemetry (emails, IPs, user-agents) - runtime data, never commit
data/user_access_logs.json

# Docker bind mount for runtime state on the VPS (campaign statuses, telemetry)
runtime-data/

# Live operational state. These are written by the running system on the
# server, and they were tracked here: every deploy did `git reset --hard`,
# which restored the committed copy over them. That is how a batch of
# scheduled social posts was lost, and how the posts database lost a column
# the deployed code required. Git must not own these files.
data/social_scheduled_campaigns.json
blog-agent/topics.csv
*.db
scratch/
